# Copy to backend/.env:  cp .env.example .env   (make setup does this for you)
DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0123456789abcdef
DATABASE_URL=postgres://rent:rent@localhost:5434/rent

# Generate with: make hatchet-token
HATCHET_CLIENT_TOKEN=
# hatchet-lite runs without TLS locally
HATCHET_CLIENT_TLS_STRATEGY=none
HATCHET_CLIENT_HOST_PORT=localhost:7079
