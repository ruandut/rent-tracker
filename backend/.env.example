# Copy to backend/.env:  cp .env.example .env   (make setup does this for you)
DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0123456789abcdef
DATABASE_URL=postgres://rent:rent@localhost:5434/rent

# Generate with: make hatchet-token
HATCHET_CLIENT_TOKEN=
# hatchet-lite runs without TLS locally
HATCHET_CLIENT_TLS_STRATEGY=none
HATCHET_CLIENT_HOST_PORT=localhost:7079

# Login captcha (django-foundation's foundation/security/captcha.py). Without a key, one is derived from DJANGO_SECRET_KEY.
# Generate one with: openssl rand -hex 32
# ALTCHA_HMAC_KEY=
# CAPTCHA_ENABLED=false skips checking the captcha; the widget still runs.
# CAPTCHA_ENABLED=true

# Two-factor sign-in encrypts its secrets with this Fernet key. Dev only: make your own for a server with
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktaW5zZWN1cmUtbWZhLWtleS1jaGFuZ2U=
# Security keys and passkeys need https or localhost; they're made for this domain (default: the request's).
# WEBAUTHN_RP_ID=

# Database backups (Django admin). pg_dump 18+, e.g. from `brew install libpq`; pg_restore is
# found next to it. Dumps go to backend/media/backups unless BACKUP_ROOT says otherwise.
# PG_DUMP=/opt/homebrew/opt/libpq/bin/pg_dump
